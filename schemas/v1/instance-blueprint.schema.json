{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gitferry.io/schemas/v1/instance-blueprint.schema.json",
  "title": "GitFerry instance blueprint v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "gitferry.io/v1"},
    "kind": {"const": "InstanceBlueprint"},
    "metadata": {"$ref": "#/$defs/metadata"},
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gitea"],
      "properties": {
        "gitea": {
          "type": "object",
          "additionalProperties": false,
          "required": ["baseUrl", "credentialSecretRef"],
          "properties": {
            "baseUrl": {"type": "string", "format": "uri", "pattern": "^https?://"},
            "credentialSecretRef": {"$ref": "#/$defs/secretRef"},
            "caSecretRef": {"$ref": "#/$defs/secretRef"},
            "expectedVersion": {"type": "string", "minLength": 1}
          }
        },
        "authenticationSources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "type", "directoryRealm", "host"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "type": {"enum": ["ldap", "ldaps"]},
              "directoryRealm": {"type": "string", "minLength": 1},
              "host": {"type": "string", "minLength": 1},
              "port": {"type": "integer", "minimum": 1, "maximum": 65535},
              "userSearchBase": {"type": "string"},
              "groupSearchBase": {"type": "string"},
              "mode": {"const": "simple"},
              "securityProtocol": {"enum": ["ldaps", "starttls"]},
              "userDn": {"type": "string", "minLength": 1},
              "userFilter": {"type": "string", "minLength": 1},
              "emailAttribute": {"type": "string", "minLength": 1},
              "usernameAttribute": {"type": "string", "minLength": 1},
              "bindSecretRef": {"$ref": "#/$defs/secretRef"},
              "caSecretRef": {"$ref": "#/$defs/secretRef"}
            },
            "oneOf": [
              {"required": ["bindSecretRef"], "not": {"required": ["mode"]}},
              {"required": ["mode", "userDn", "userFilter", "emailAttribute", "caSecretRef"], "not": {"required": ["bindSecretRef"]}}
            ],
            "allOf": [
              {
                "if": {"required": ["mode"], "properties": {"mode": {"const": "simple"}}},
                "then": {
                  "if": {"properties": {"type": {"const": "ldap"}}},
                  "then": {
                    "required": ["securityProtocol"],
                    "properties": {"securityProtocol": {"const": "starttls"}}
                  },
                  "else": {
                    "properties": {"securityProtocol": {"const": "ldaps"}}
                  }
                }
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {"name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"}}
    },
    "secretRef": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"}
  }
}
