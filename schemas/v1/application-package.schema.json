{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gitferry.io/schemas/v1/application-package.schema.json",
  "title": "GitFerry application package v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schema_version",
    "package_id",
    "transfer_round_id",
    "producer_version",
    "created_at",
    "mode",
    "sender",
    "recipient",
    "repositories",
    "realms",
    "metadata",
    "inventory_complete",
    "limitations",
    "deletion_semantics"
  ],
  "properties": {
    "format": {
      "const": "gitferry.application-package"
    },
    "schema_version": {
      "const": 1
    },
    "package_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "transfer_round_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "producer_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "mode": {
      "const": "first-import"
    },
    "sender": {
      "$ref": "#/$defs/endpoint"
    },
    "recipient": {
      "$ref": "#/$defs/endpoint"
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/repository"
      }
    },
    "realms": {
      "type": "array",
      "minItems": 0,
      "maxItems": 512,
      "items": {
        "$ref": "#/$defs/realm"
      }
    },
    "metadata": {
      "oneOf": [
        {
          "$ref": "#/$defs/metadata"
        },
        {
          "type": "null"
        }
      ]
    },
    "inventory_complete": {
      "const": false
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "deletion_semantics": {
      "const": "absence-does-not-delete"
    }
  },
  "$defs": {
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instance_key",
        "installation_marker"
      ],
      "properties": {
        "instance_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "installation_marker": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "realm_key",
        "login",
        "external_id",
        "ou_path"
      ],
      "properties": {
        "realm_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "login": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "external_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "ou_path": {
          "type": "string",
          "maxLength": 1024
        }
      }
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instance_key",
        "global_id"
      ],
      "properties": {
        "instance_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "global_id": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$",
          "maxLength": 128
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "size",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1099511627776
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "team": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "name",
        "permission",
        "members"
      ],
      "properties": {
        "origin": {
          "$ref": "#/$defs/origin"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "permission": {
          "enum": [
            "read",
            "write"
          ]
        },
        "members": {
          "type": "array",
          "minItems": 0,
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/selector"
          }
        }
      }
    },
    "organization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "name"
      ],
      "properties": {
        "origin": {
          "$ref": "#/$defs/origin"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "repository",
        "organization",
        "teams",
        "bundle"
      ],
      "properties": {
        "origin": {
          "$ref": "#/$defs/origin"
        },
        "repository": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "organization": {
          "$ref": "#/$defs/organization"
        },
        "teams": {
          "type": "array",
          "minItems": 0,
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/team"
          }
        },
        "bundle": {
          "oneOf": [
            {
              "$ref": "#/$defs/file"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "directory",
        "manifest_id",
        "digest_sha256",
        "issue_authors"
      ],
      "properties": {
        "directory": {
          "const": "metadata"
        },
        "manifest_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "digest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "issue_authors": {
          "type": "array",
          "minItems": 0,
          "maxItems": 2000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "origin",
              "author"
            ],
            "properties": {
              "origin": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "instance_key",
                  "repository",
                  "object_type",
                  "global_id"
                ],
                "properties": {
                  "instance_key": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
                  },
                  "repository": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "object_type": {
                    "const": "issue"
                  },
                  "global_id": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]*$",
                    "maxLength": 128
                  }
                }
              },
              "author": {
                "$ref": "#/$defs/selector"
              }
            }
          }
        }
      }
    },
    "realm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "realm_key",
        "kind",
        "description"
      ],
      "properties": {
        "realm_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "kind": {
          "enum": [
            "gitea-local",
            "external"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    }
  }
}
