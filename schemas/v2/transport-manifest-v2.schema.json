{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gitferry.io/schemas/v2/transport-manifest-v2.schema.json",
  "title": "GitFerry portable transport manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schema_version", "manifest_id", "transfer_round_id", "producer_version", "sender", "recipient", "mode", "created_at", "deletion_semantics", "selected_repositories", "identity_claims", "objects", "payloads"],
  "properties": {
    "format": {"const": "gitferry.transport"},
    "schema_version": {"const": 2},
    "manifest_id": {"$ref": "#/$defs/stableKey"},
    "transfer_round_id": {"$ref": "#/$defs/stableKey"},
    "producer_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "sender": {"$ref": "#/$defs/instanceRef"},
    "recipient": {
      "allOf": [
        {"$ref": "#/$defs/instanceRef"},
        {"type": "object", "required": ["context"], "properties": {"context": {"type": "string", "minLength": 1, "maxLength": 256}}}
      ]
    },
    "mode": {"enum": ["forward", "return"]},
    "created_at": {"type": "string", "format": "date-time"},
    "forward_reference": {"$ref": "#/$defs/manifestReference"},
    "deletion_semantics": {"const": "absence-does-not-delete"},
    "selected_repositories": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/repositorySelection"}},
    "identity_claims": {"type": "array", "maxItems": 512, "items": {"$ref": "#/$defs/identityClaim"}},
    "objects": {"type": "array", "maxItems": 2000, "items": {"oneOf": [{"$ref": "#/$defs/issueRecord"}, {"$ref": "#/$defs/commentRecord"}]}},
    "payloads": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/payload"}}
  },
  "allOf": [{"if": {"properties": {"mode": {"const": "return"}}}, "then": {"required": ["forward_reference"]}, "else": {"not": {"required": ["forward_reference"]}}}],
  "$defs": {
    "stableKey": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "decimalString": {"type": "string", "pattern": "^[0-9]+$", "maxLength": 40},
    "repository": {"type": "string", "minLength": 3, "maxLength": 255, "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "instanceRef": {
      "type": "object", "additionalProperties": false, "required": ["instance_key", "installation_marker"],
      "properties": {"instance_key": {"$ref": "#/$defs/stableKey"}, "installation_marker": {"$ref": "#/$defs/stableKey"}, "context": {"type": "string", "minLength": 1, "maxLength": 256}}
    },
    "manifestReference": {
      "type": "object", "additionalProperties": false, "required": ["manifest_id", "digest_sha256"],
      "properties": {"manifest_id": {"$ref": "#/$defs/stableKey"}, "digest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
    },
    "repositorySelection": {
      "type": "object", "additionalProperties": false, "required": ["repository", "object_types", "fields", "capabilities", "limitations"],
      "properties": {
        "repository": {"$ref": "#/$defs/repository"},
        "object_types": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["issue", "issue_comment"]}},
        "fields": {"type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": {"enum": ["title", "body", "state", "labels", "comment.body"]}},
        "capabilities": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"enum": ["issue-create", "issue-update", "issue-comment-create", "issue-comment-update"]}},
        "limitations": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 200}}
      }
    },
    "identitySelector": {
      "type": "object", "additionalProperties": false, "required": ["realm_key", "login", "external_id", "ou_path"],
      "properties": {"realm_key": {"$ref": "#/$defs/stableKey"}, "login": {"type": "string", "minLength": 1, "maxLength": 255}, "external_id": {"type": "string", "minLength": 1, "maxLength": 512}, "ou_path": {"type": "string", "minLength": 1, "maxLength": 1024}}
    },
    "identityClaim": {
      "type": "object", "additionalProperties": false,
      "required": ["realm_key", "login", "external_id", "ou_path", "relationship"],
      "properties": {
        "realm_key": {"$ref": "#/$defs/stableKey"},
        "login": {"type": "string", "minLength": 1, "maxLength": 255},
        "external_id": {"type": "string", "minLength": 1, "maxLength": 512},
        "ou_path": {"type": "string", "minLength": 1, "maxLength": 1024},
        "relationship": {"type": "object", "additionalProperties": false, "required": ["instance_key", "account_id", "login", "status"], "properties": {"instance_key": {"$ref": "#/$defs/stableKey"}, "account_id": {"$ref": "#/$defs/decimalString"}, "login": {"type": "string", "minLength": 1, "maxLength": 255}, "status": {"enum": ["observed-not-approved", "proposed"]}}}
      }
    },
    "issueOriginRef": {
      "type": "object", "additionalProperties": false, "required": ["instance_key", "repository", "object_type", "global_id"],
      "properties": {"instance_key": {"$ref": "#/$defs/stableKey"}, "repository": {"$ref": "#/$defs/repository"}, "object_type": {"const": "issue"}, "global_id": {"$ref": "#/$defs/decimalString"}}
    },
    "issueOrigin": {
      "type": "object", "additionalProperties": false, "required": ["instance_key", "repository", "object_type", "global_id", "issue_index"],
      "properties": {"instance_key": {"$ref": "#/$defs/stableKey"}, "repository": {"$ref": "#/$defs/repository"}, "object_type": {"const": "issue"}, "global_id": {"$ref": "#/$defs/decimalString"}, "issue_index": {"$ref": "#/$defs/decimalString"}, "created_at": {"type": "string", "format": "date-time"}}
    },
    "commentOrigin": {
      "type": "object", "additionalProperties": false, "required": ["instance_key", "repository", "object_type", "global_id", "parent_issue_origin", "created_at"],
      "properties": {"instance_key": {"$ref": "#/$defs/stableKey"}, "repository": {"$ref": "#/$defs/repository"}, "object_type": {"const": "issue_comment"}, "global_id": {"$ref": "#/$defs/decimalString"}, "parent_issue_origin": {"$ref": "#/$defs/issueOriginRef"}, "created_at": {"type": "string", "format": "date-time"}}
    },
    "issueReplica": {
      "type": "object", "additionalProperties": false, "required": ["instance_key", "repository", "global_id", "issue_index"],
      "properties": {"instance_key": {"$ref": "#/$defs/stableKey"}, "repository": {"$ref": "#/$defs/repository"}, "global_id": {"$ref": "#/$defs/decimalString"}, "issue_index": {"$ref": "#/$defs/decimalString"}, "native_created_at": {"type": "string", "format": "date-time"}}
    },
    "commentReplica": {
      "type": "object", "additionalProperties": false, "required": ["instance_key", "repository", "global_id", "parent_issue_index"],
      "properties": {"instance_key": {"$ref": "#/$defs/stableKey"}, "repository": {"$ref": "#/$defs/repository"}, "global_id": {"$ref": "#/$defs/decimalString"}, "parent_issue_index": {"$ref": "#/$defs/decimalString"}, "native_created_at": {"type": "string", "format": "date-time"}}
    },
    "issueValues": {
      "type": "object", "additionalProperties": false, "required": ["title", "body", "state", "labels"],
      "properties": {"title": {"type": "string", "maxLength": 512}, "body": {"type": "string", "maxLength": 262144}, "state": {"enum": ["open", "closed"]}, "labels": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 255}}}
    },
    "commentValues": {"type": "object", "additionalProperties": false, "required": ["body"], "properties": {"body": {"type": "string", "maxLength": 262144}}},
    "baselineOrigin": {"type": "object", "additionalProperties": false, "required": ["instance_key", "transfer_round_id"], "properties": {"instance_key": {"$ref": "#/$defs/stableKey"}, "transfer_round_id": {"$ref": "#/$defs/stableKey"}}},
    "issueComparison": {
      "type": "object", "additionalProperties": false, "required": ["ruleset", "ruleset_version", "original_baseline", "confirmed_import", "current", "baseline_origin"],
      "properties": {"ruleset": {"const": "gitea-issue-selected-fields"}, "ruleset_version": {"const": 1}, "original_baseline": {"oneOf": [{"$ref": "#/$defs/issueValues"}, {"type": "null"}]}, "confirmed_import": {"oneOf": [{"$ref": "#/$defs/issueValues"}, {"type": "null"}]}, "current": {"$ref": "#/$defs/issueValues"}, "baseline_origin": {"$ref": "#/$defs/baselineOrigin"}}
    },
    "commentComparison": {
      "type": "object", "additionalProperties": false, "required": ["ruleset", "ruleset_version", "original_baseline", "confirmed_import", "current", "baseline_origin"],
      "properties": {"ruleset": {"const": "gitea-issue-comment-body"}, "ruleset_version": {"const": 1}, "original_baseline": {"oneOf": [{"$ref": "#/$defs/commentValues"}, {"type": "null"}]}, "confirmed_import": {"oneOf": [{"$ref": "#/$defs/commentValues"}, {"type": "null"}]}, "current": {"$ref": "#/$defs/commentValues"}, "baseline_origin": {"$ref": "#/$defs/baselineOrigin"}}
    },
    "issueRecord": {"type": "object", "additionalProperties": false, "required": ["origin", "replicas", "comparison"], "properties": {"origin": {"$ref": "#/$defs/issueOrigin"}, "replicas": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/issueReplica"}}, "comparison": {"$ref": "#/$defs/issueComparison"}}},
    "commentRecord": {"type": "object", "additionalProperties": false, "required": ["origin", "replicas", "author", "comparison"], "properties": {"origin": {"$ref": "#/$defs/commentOrigin"}, "replicas": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/commentReplica"}}, "author": {"$ref": "#/$defs/identitySelector"}, "comparison": {"$ref": "#/$defs/commentComparison"}}},
    "payload": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "size", "purpose"], "properties": {"path": {"type": "string", "minLength": 1, "maxLength": 512}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "size": {"type": "integer", "minimum": 0, "maximum": 1073741824}, "purpose": {"enum": ["git-bundle", "issue-payload", "issue-comment-payload"]}}}
  }
}
