# Prefer an immutable digest once a candidate image exists. No image is published by this example.
GITFERRY_IMAGE=gitferry:dev
GITFERRY_LISTEN_ADDRESS=127.0.0.1
GITFERRY_PORT=8080

# These files are mounted as Compose secrets. Do not place their values in this file.
GITFERRY_SOURCE_TOKEN_FILE=./secrets/source-api-token
GITFERRY_TARGET_TOKEN_FILE=./secrets/target-api-token
# Additional bound-author credential files use their filenames as local reference aliases.
GITFERRY_CREDENTIAL_DIR=./secrets

# Mount one operator-owned directory containing internal CA certificates when required.
GITFERRY_CA_DIR=./ca
